            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/sos?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["sos"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] }
