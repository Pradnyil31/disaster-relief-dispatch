{
  "info": {
    "_postman_id": "disaster-relief-coordinator-api-v2",
    "name": "Disaster Relief Coordinator API",
    "description": "Complete Postman Collection covering all 8 modules of the Disaster Relief Coordinator Backend with automated token chaining and schema validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "volunteerToken", "value": "", "type": "string" },
    { "key": "citizenToken", "value": "", "type": "string" },
    { "key": "donorToken", "value": "", "type": "string" },
    { "key": "citizenEmail", "value": "", "type": "string" },
    { "key": "donorEmail", "value": "", "type": "string" },
    { "key": "sosId", "value": "1", "type": "string" },
    { "key": "inventoryId", "value": "1", "type": "string" },
    { "key": "dispatchId", "value": "1", "type": "string" },
    { "key": "donationId", "value": "1", "type": "string" },
    { "key": "monetaryDonationId", "value": "1", "type": "string" },
    { "key": "managedUserId", "value": "3", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl') || 'http://localhost:8080/api/v1';",
          "const headers = JSON.stringify(pm.request.headers || {});",
          "",
          "// Auto-login for Admin if token is missing",
          "if (headers.includes('adminToken') && !pm.collectionVariables.get('adminToken') && !pm.environment.get('adminToken')) {",
          "    pm.sendRequest({",
          "        url: baseUrl + '/auth/login',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify({ email: 'admin@example.com', password: 'admin123' }) }",
          "    }, function (err, res) {",
          "        if (!err && res.code === 200) {",
          "            const data = res.json();",
          "            pm.collectionVariables.set('adminToken', data.token);",
          "            pm.environment.set('adminToken', data.token);",
          "        }",
          "    });",
          "}",
          "",
          "// Auto-login for Volunteer if token is missing",
          "if (headers.includes('volunteerToken') && !pm.collectionVariables.get('volunteerToken') && !pm.environment.get('volunteerToken')) {",
          "    pm.sendRequest({",
          "        url: baseUrl + '/auth/login',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify({ email: 'volunteer@example.com', password: 'volunteer123' }) }",
          "    }, function (err, res) {",
          "        if (!err && res.code === 200) {",
          "            const data = res.json();",
          "            pm.collectionVariables.set('volunteerToken', data.token);",
          "            pm.environment.set('volunteerToken', data.token);",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
