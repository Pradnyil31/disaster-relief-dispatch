              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('citizenToken', res.token);",
                  "    pm.environment.set('citizenToken', res.token);",
                  "    console.log('✅ citizenToken saved from register');",
                  "}"
