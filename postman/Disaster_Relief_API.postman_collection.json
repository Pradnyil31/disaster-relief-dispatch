        },
        {
          "name": "Get My Donations (Donor)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{donorToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/donations/my", "host": ["{{baseUrl}}"], "path": ["donations", "my"] }
          }
        },
        {
          "name": "Pledge Relief Goods Supply Donation (Public/Donor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('donationId', res.id);",
                  "    pm.environment.set('donationId', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"GOODS\",\n  \"itemName\": \"Heavy Duty Blankets\",\n  \"category\": \"SHELTER_AND_BLANKETS\",\n  \"quantity\": 50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/donations/pledge", "host": ["{{baseUrl}}"], "path": ["donations", "pledge"] }
          }
        },
        {
          "name": "Get All Donations (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/donations", "host": ["{{baseUrl}}"], "path": ["donations"] }
          }
        },
        {
          "name": "Approve Physical Donation (Admin Auto Inventory Sync)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/donations/{{donationId}}/approve", "host": ["{{baseUrl}}"], "path": ["donations", "{{donationId}}", "approve"] }
          }
        },
        {
          "name": "Verify Monetary Payment (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/donations/{{monetaryDonationId}}/verify-payment", "host": ["{{baseUrl}}"], "path": ["donations", "{{monetaryDonationId}}", "verify-payment"] }
          }
        }
      ]
    },
    {
      "name": "07. Admin User Management",
      "item": [
        {
          "name": "Get All System Users (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/users?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["admin", "users"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] }
          }
        },
        {
          "name": "Filter Users by Role (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/users?role=VOLUNTEER&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["admin", "users"], "query": [{ "key": "role", "value": "VOLUNTEER" }, { "key": "page", "value": "0" }, { "key": "size", "value": "20" }] }
          }
        },
        {
          "name": "Create User Account (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('managedUserId', res.id);",
                  "    pm.environment.set('managedUserId', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Field Officer\",\n  \"email\": \"officer_{{$timestamp}}@example.com\",\n  \"password\": \"OfficerPass@123\",\n  \"role\": \"VOLUNTEER\",\n  \"phone\": \"9811223344\",\n  \"zone\": \"North Relief Sector\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "Update User Details (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Field Officer (Promoted)\",\n  \"role\": \"VOLUNTEER\",\n  \"phone\": \"9811223355\",\n  \"zone\": \"Central Command\",\n  \"isActive\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/users/{{managedUserId}}", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{managedUserId}}"] }
          }
        }
      ]
    }
  ]
