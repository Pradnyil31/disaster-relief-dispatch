                  "    pm.environment.set('sosId', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"urgencyLevel\": \"HIGH\",\n  \"latitude\": 19.076,\n  \"longitude\": 72.8777,\n  \"locationName\": \"123 Main St, Sector 4\",\n  \"requiredSupplies\": [\"WATER_AND_HYDRATION\", \"FOOD_AND_RATIONS\"],\n  \"citizenPhone\": \"9876543210\",\n  \"notes\": \"Family stranded on roof.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/sos", "host": ["{{baseUrl}}"], "path": ["sos"] }
          }
        },
